---
import Layout from '../layouts/Layout.astro';
import { getPlayers } from '../services/api';

const players = await getPlayers();
---

<Layout title="Plantel - Club Unión Florida">
    <main class="container">
        <h1>Plantel Liga Nacional</h1>
        <div class="players-grid">
            {players.map((p) => (
                <div class="player-card">
                    <div class="image-wrapper">
                        {p.image ? (
                            <img src={p.image} alt={p.name} />
                        ) : (
                            <div style="height:300px; background:#ddd; display:flex; align-items:center; justify-content:center;">Sin Imagen</div>
                        )}
                    </div>
                    <div class="info">
                        {p.name}
                    </div>
                    <div class="description">
                        {(p.bio || 'Sin biografía disponible')
                            .replace(/\.\s/g, '.\n')
                            .split('\n')
                            .map((t) => t.trim())
                            .filter(Boolean)
                            .map((t) => <p>{t}</p>)}
                    </div>
                </div>
            ))}
        </div>
    </main>
</Layout>

<script>
    let openCard: Element | null = null;

    document.addEventListener('click', (e) => {
        const card = (e.target as Element | null)?.closest('.player-card') ?? null;

        if (openCard && openCard !== card) {
            openCard.classList.remove('active');
            openCard = null;
        }

        if (card) {
            const isActive = card.classList.toggle('active');
            openCard = isActive ? card : null;
        }
    });
</script>
