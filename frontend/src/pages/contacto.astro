---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto - Club Unión Florida">
    <main class="contact-container" style="display:grid; grid-template-columns: 1fr 1fr; gap: 2rem; max-width: 1200px; margin: 6rem auto;">
        <div class="contact-info">
            <h2>CONTACTO</h2>
            <p>
                Bernardo de Irigoyen 1540, B1602 Florida Oeste, Provincia de Buenos
                Aires
            </p>
            <p>cuf.femenino@gmail.com</p>
            <iframe
                src="https://www.google.com/maps?q=Bernardo+de+Irigoyen+1540,+Florida+Oeste,+Buenos+Aires&output=embed"
                width="100%" height="200" style="border: 0; border-radius: 8px" allowfullscreen=""
                loading="lazy"></iframe>
        </div>

        <form class="contact-form" id="contact-form" action="https://formspree.io/f/mvgqbrwe" method="POST">
            <label>Nombre*
                <input type="text" name="nombre" required />
            </label>
            <label>Email*
                <input type="email" name="email" required />
            </label>
            <label>Comentarios
                <textarea name="comentarios" rows="4"></textarea>
            </label>
            <button type="submit">Enviar</button>
            <div id="form-message" style="margin-top: 1rem;"></div>
        </form>
    </main>
</Layout>
