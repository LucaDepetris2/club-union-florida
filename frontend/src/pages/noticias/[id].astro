---
import Layout from "../../layouts/Layout.astro";
import { getNewsById } from "../../services/api";

const { id } = Astro.params;

// En SSR, Astro.props no tiene 'item' (no hay getStaticPaths)
// Fetch always
const item = id ? await getNewsById(id) : null;

if (!item) {
    return Astro.redirect("/404");
}
---

<Layout title={item.title}>
    <link rel="stylesheet" href="/css/news.css" />

    <!-- DISEÑO ESTÁNDAR LIMPIO (SAFE LAYOUT) -->
    <main class="news-standard-layout">
        <article class="standard-article" data-news-id={item.id}>
            <!-- Usamos DIV en lugar de HEADER para evitar conflicto con navbar.css global -->
            <div class="standard-header">
                <span class="standard-category"
                    >{item.category || "Novedades"}</span
                >
                <h1 class="standard-title">{item.title}</h1>
                {
                    item.subtitle && (
                        <p class="standard-subtitle">{item.subtitle}</p>
                    )
                }

                <div class="standard-date-wrapper">
                    <span class="standard-date">
                        {
                            new Date(item.date).toLocaleDateString("es-AR", {
                                day: "numeric",
                                month: "long",
                                year: "numeric",
                            })
                        }
                    </span>
                </div>
            </div>

            {
                item.image && (
                    <div class="standard-image-container">
                        <img
                            src={item.image}
                            alt={item.title}
                            class="standard-image"
                            style={{
                                objectPosition:
                                    item.imagePosition || "center center",
                                objectFit: item.imageFit || "cover",
                                maxHeight:
                                    item.imageFit === "contain"
                                        ? "80vh"
                                        : "500px",
                                width:
                                    item.imageFit === "contain"
                                        ? "auto"
                                        : "100%",
                                maxWidth: "100%",
                                margin: "0 auto",
                                display: "block",
                                backgroundColor:
                                    item.imageFit === "contain"
                                        ? "#f8f9fa"
                                        : "transparent",
                            }}
                        />
                    </div>
                )
            }

            <div
                class="standard-body"
                set:html={item.content.replace(/\n/g, "<br />")}
            />

            <div class="standard-footer">
                <a href="/noticias" class="standard-back-btn">
                    Volver a Noticias
                </a>
            </div>
        </article>
    </main>
</Layout>

<script>
    // Contador de vistas: se cuenta desde el navegador (los bots sin JS no suman)
    // y como máximo una vez cada 24 h por noticia y navegador.
    const API =
        import.meta.env.PUBLIC_API_URL ||
        (import.meta.env.PROD ? "/api" : "http://localhost:3000/api");
    const DAY_MS = 24 * 60 * 60 * 1000;

    const id = document.querySelector<HTMLElement>("[data-news-id]")?.dataset.newsId;

    if (id) {
        const key = `cuf_view_${id}`;
        let shouldCount = true;
        try {
            const last = Number(localStorage.getItem(key));
            shouldCount = !last || Date.now() - last > DAY_MS;
        } catch {
            // storage bloqueado (modo privado, etc.): contamos igual
        }

        if (shouldCount) {
            fetch(`${API}/news/${id}/view`, { method: "POST", keepalive: true })
                .then((res) => {
                    if (!res.ok) return;
                    try {
                        localStorage.setItem(key, String(Date.now()));
                    } catch {}
                })
                .catch(() => {});
        }
    }
</script>
