---
interface Props {
  title: string;
}

const { title } = Astro.props;
// import '../styles/global.css'; // Desactivamos reset de Tailwind para mantener estilos originales
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Sitio oficial del Club Unión Florida de Básquet Femenino"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/img/FAVICON_CUF_WEB.png" />
    <link rel="stylesheet" href="/css/main.css" />
    <!-- Legacy styles -->
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav class="navbar">
        <div class="nav-logo">
          <a href="/">
            <img
              src="/img/logo.png"
              alt="Club Unión Florida"
              class="logo-img"
            />
          </a>
        </div>

        <!-- Botón hamburguesa (Mobile not implemented in Astro yet properly, using CSS hover or React later) -->
        <div class="menu-toggle" id="menu-toggle">&#9776;</div>

        <div class="nav-center" id="nav-center">
          <a href="/">Inicio</a>
          <a href="/historia">Historia</a>
          <a href="/noticias">Noticias</a>
          <a href="/jugadores">Liga Nacional</a>
          <a href="/afmb">AFMB</a>
          <a href="/contacto">Contacto</a>

          <div class="nav-icons">
            <a
              href="https://www.instagram.com/cuf_femenino/"
              target="_blank"
              aria-label="Instagram"
            >
              <img src="/img/instagram.svg" alt="Instagram" />
            </a>
            <a
              href="https://www.tiktok.com/@cuf.femenino"
              target="_blank"
              aria-label="TikTok"
            >
              <img src="/img/tiktok.svg" alt="TikTok" />
            </a>
          </div>
        </div>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <p class="footer-title">Nuestros sponsors</p>

      <div class="footer-sponsors">
        <a href="https://purobasquet.com" target="_blank">
          <img src="/img/sponsor1.png" alt="purobasquet" />
        </a>
        <a href="https://www.instagram.com/puntocandy.distribuidora?dlrf=M3ZzcjhqaTVpYWV5" target="_blank">
          <img src="/img/sponsor2.png" alt="PuntoCandy" />
        </a>
        <a href="https://www.fleetsa.com.ar" target="_blank">
          <img src="/img/sponsor3.png" alt="fleetsa" />
        </a>
      </div>

      <p class="footer-copy">
        Club Unión Florida © 2026. Desarrollado por Brava Estudio
      </p>
    </footer>

    <script>
      // Mobile Menu Logic
      // Mobile Menu Logic
      const toggle = document.getElementById("menu-toggle");
      const nav = document.getElementById("nav-center");
      toggle?.addEventListener("click", () => {
        nav?.classList.toggle("show"); // Use 'show' to match navbar.css
      });
    </script>
  </body>
</html>
